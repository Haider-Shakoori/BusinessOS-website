APP_NAME="BusinessOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://businessos.af

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kabul

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=400
# Optional: set the trusted country header supplied by your CDN/host.
# Example for Cloudflare: CF-IPCountry
ANALYTICS_COUNTRY_HEADER=


# Google Analytics 4: public tag (G-...) and optional private dashboard reporting.
# GA4_PROPERTY_ID is the numeric PROPERTY ID, not the G- measurement ID.
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
# Absolute path outside public/ to a service-account JSON file readable by PHP.
GA4_CREDENTIALS_PATH=
GA4_REPORT_CACHE_MINUTES=15

# Search discovery
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_TIMEOUT=4

APP_NAME="BusinessOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://businessos.af

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kabul

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

ANALYTICS_ENABLED=true
ANALYTICS_RETENTION_DAYS=400
# Optional: set the trusted country header supplied by your CDN/host.
# Example for Cloudflare: CF-IPCountry
ANALYTICS_COUNTRY_HEADER=


# Search discovery
INDEXNOW_ENABLED=false
INDEXNOW_KEY=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow
INDEXNOW_TIMEOUT=4

# Google Analytics 4 (separate from BusinessOS first-party analytics).
# Measurement ID is G-...; Property ID is numeric. Do not reuse RelayWA IDs.
GA4_MEASUREMENT_ID=
GA4_PROPERTY_ID=
GA4_CREDENTIALS_PATH=
GA4_REPORT_CACHE_MINUTES=15
# Optional header from an explicitly trusted edge provider (never an arbitrary client header).
# Leave empty to use the local country MMDB, if installed. Unknown regions need opt-in.
GA4_TRUSTED_COUNTRY_HEADER=


# Google Search Console: actual organic search impressions by keyword/page.
# Property must exactly match its GSC name: sc-domain:businessos.af or https://businessos.af/
# Reuse GA4_CREDENTIALS_PATH if the service account also has Search Console access.
SEARCH_CONSOLE_SITE_URL=
SEARCH_CONSOLE_CREDENTIALS_PATH=
SEARCH_CONSOLE_CACHE_MINUTES=30

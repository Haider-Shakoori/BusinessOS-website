APP_NAME="BusinessOS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://businessos.af

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Kabul

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=local

ANALYTICS_ENABLED=true
# Optional: set the trusted country header supplied by your CDN/host.
# Example for Cloudflare: CF-IPCountry
ANALYTICS_COUNTRY_HEADER=
